# Copy to qualification.env, chmod 600, and keep the copy out of version control.
QUAL_CLEARINGHOUSE_URL=http://localhost:8080
QUAL_GATEWAY_ROOT=/home/mazup/git-repos/livepeer-cloud-spe/livepeer-python-gateway
QUAL_API_CREDENTIAL=och_live_REPLACE_ME

QUAL_CAPABILITY=livepeer-example/flux-klein
QUAL_MODEL=
QUAL_ORCHESTRATOR=https://ai1.eliteencoder.net:8936
QUAL_EXPECT_CURRENCY=wei
QUAL_EXPECT_UNIT=seconds
QUAL_MAX_PRICE_NUMERATOR=2000000000
QUAL_MAX_PRICE_DENOMINATOR=1

QUAL_WORKLOAD_TTL_SECONDS=600
QUAL_EXECUTION_TIMEOUT_SECONDS=120
QUAL_METERING_TIMEOUT_SECONDS=120
QUAL_SESSION_HOLD_SECONDS=2
QUAL_ALLOW_STALE_DISCOVERY=false
QUAL_EXECUTE=false
QUAL_EVIDENCE_ROOT=tmp/qualification

# Suite-wide fail-closed spending and runtime guards. These cap quoted usage;
# signer deposits and reserves are collateral and are configured separately.
QUALIFICATION_MAX_TOTAL_FEE_WEI=1000000000000
QUALIFICATION_MAX_CASE_FEE_WEI=100000000000
QUALIFICATION_MAX_DURATION_SECONDS=30
QUALIFICATION_ALLOW_LV2V=false

# Optional payloads make availability explicit; no public workload is guessed.
QUAL_FIXED_PAYLOAD_JSON=
QUAL_LV2V_INPUT=
QUAL_LV2V_MODEL=
