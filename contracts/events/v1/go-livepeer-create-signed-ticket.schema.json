{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearinghouse.livepeer.org/contracts/events/v1/go-livepeer-create-signed-ticket.schema.json",
  "title": "Raw go-livepeer create_signed_ticket Kafka event",
  "description": "Compatibility input emitted by go-livepeer monitor.SendQueueEventAsync. This contract is pinned to go-livepeer commit e8dcf7a34744d5cb6b65ba43c0d9160a3975ccc6 and is normalized before domain use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "timestamp", "data"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "create_signed_ticket"
    },
    "timestamp": {
      "description": "Signed int64 Unix epoch milliseconds encoded as a decimal string by go-livepeer. Consumers additionally enforce the exact int64 bound.",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|-[1-9][0-9]{0,18})$"
    },
    "gateway": {
      "type": "string",
      "maxLength": 512
    },
    "data": {
      "$ref": "#/$defs/createSignedTicketData"
    }
  },
  "$defs": {
    "createSignedTicketData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_status",
        "app",
        "pipeline",
        "request_id",
        "orch_address",
        "orch_url",
        "manifest_id",
        "pm_session_id",
        "current_time",
        "current_time_unix",
        "previous_time",
        "previous_time_unix",
        "billable_secs",
        "pixels",
        "session_balance",
        "computed_fee",
        "cost",
        "sequence_number",
        "num_tickets",
        "auth_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_status": {
          "type": "string",
          "enum": ["new", "continuing"]
        },
        "app": {
          "type": "string",
          "maxLength": 512
        },
        "pipeline": {
          "type": "string",
          "enum": ["", "live", "live-video-to-video", "fixed"]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "orch_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "orch_url": {
          "type": "string",
          "maxLength": 2048
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "pm_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "current_time": {
          "type": "string",
          "format": "date-time",
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "current_time_unix": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "previous_time": {
          "type": "string",
          "format": "date-time",
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "previous_time_unix": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "billable_secs": {
          "description": "Raw finite float64 duration from go-livepeer. The decimal JSON token is bounded to the exact signed nanosecond range and normalization converts it without binary floating-point arithmetic.",
          "type": "number",
          "minimum": -9223372036.854775807,
          "maximum": 9223372036.854775807
        },
        "pixels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "session_balance": {
          "type": "string",
          "description": "Rounded non-negative integer emitted by big.Rat.FloatString(0). The authorization callback State.Balance uses a different rational representation.",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "computed_fee": {
          "type": "string",
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "cost": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{10})$"
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "num_tickets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "auth_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
