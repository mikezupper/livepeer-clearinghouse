# Livepeer Open Clearinghouse — copy to .env and replace every marked value.
# `.env` is ignored. Production secrets belong in a deployment secret store.

# Process and PostgreSQL
CLEARINGHOUSE_EDGE_PORT=8080
COMPOSE_PROJECT_NAME=livepeer-clearinghouse
POSTGRES_USER=clearinghouse
POSTGRES_PASSWORD_HOST_FILE=./tmp/runtime-secrets/postgres-password
POSTGRES_DB=clearinghouse
CLEARINGHOUSE_SECRET_OWNER_UID=1000
CLEARINGHOUSE_ENVIRONMENT=development
CLEARINGHOUSE_LOG_LEVEL=INFO
CLEARINGHOUSE_OTEL_EXPORTER_OTLP_ENDPOINT=
CLEARINGHOUSE_OTEL_METRIC_EXPORT_INTERVAL_MILLIS=60000
CLEARINGHOUSE_DATABASE_POOL_SIZE=10
CLEARINGHOUSE_DATABASE_POOL_TIMEOUT_SECONDS=5
CLEARINGHOUSE_HTTP_HOST=127.0.0.1
CLEARINGHOUSE_HTTP_PORT=8000

# Independent keyed-hash secrets. Local files are generated under ignored tmp/;
# production paths must point outside this checkout and Docker build context.
CLEARINGHOUSE_AUTH_PEPPER_HOST_FILE=./tmp/runtime-secrets/auth-pepper
CLEARINGHOUSE_CREDENTIAL_PEPPER_HOST_FILE=./tmp/runtime-secrets/credential-pepper

# Optional one-shot operator bootstrap. Set both only for the first deployment,
# then remove them after a successful start. The secret must be 32+ characters.
CLEARINGHOUSE_OPERATOR_BOOTSTRAP_EMAIL_HOST_FILE=./tmp/runtime-secrets/operator-bootstrap-email
CLEARINGHOUSE_OPERATOR_BOOTSTRAP_SECRET_HOST_FILE=./tmp/runtime-secrets/operator-bootstrap-secret
CLEARINGHOUSE_IDENTITY_INVITATION_TTL_SECONDS=86400

# Signer sessions and private authorization callback.
CLEARINGHOUSE_SIGNER_WEBHOOK_SECRET_HOST_FILE=./tmp/runtime-secrets/signer-webhook-secret
CLEARINGHOUSE_SIGNER_SESSION_PEPPER_HOST_FILE=./tmp/runtime-secrets/signer-session-pepper
CLEARINGHOUSE_SIGNER_GLOBAL_EXPOSURE_CAP=0
CLEARINGHOUSE_SIGNER_ID=signer_default0000
# Browser-facing endpoints; Compose supplies its private remote-signer URL separately.
CLEARINGHOUSE_SIGNER_URL=http://127.0.0.1:8080
CLEARINGHOUSE_SIGNER_DISCOVERY_URL=http://127.0.0.1:8080

# Default email-code sign-in through the official Resend SDK. The API URL may
# point at a Resend-compatible service; production requires HTTPS.
CLEARINGHOUSE_AUTH_RESEND_API_URL=https://api.resend.com
CLEARINGHOUSE_AUTH_RESEND_API_KEY_HOST_FILE=./tmp/runtime-secrets/resend-api-key
CLEARINGHOUSE_AUTH_RESEND_FROM="Livepeer Clearinghouse <auth@your-domain.example>"
CLEARINGHOUSE_AUTH_OTP_TTL_SECONDS=600
CLEARINGHOUSE_AUTH_OTP_MAX_ATTEMPTS=5
CLEARINGHOUSE_AUTH_OTP_SEND_LIMIT=5
CLEARINGHOUSE_AUTH_OTP_SEND_WINDOW_SECONDS=3600
CLEARINGHOUSE_AUTH_OTP_VERIFY_LIMIT=10
CLEARINGHOUSE_AUTH_OTP_VERIFY_WINDOW_SECONDS=900

# Browser sessions, OAuth abuse controls, CSRF origins, and post-login target.
# Exact origins only: no paths, queries, fragments, credentials, or wildcards.
CLEARINGHOUSE_AUTH_SESSION_TTL_SECONDS=86400
CLEARINGHOUSE_AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
CLEARINGHOUSE_AUTH_SESSION_INACTIVITY_SECONDS=3600
CLEARINGHOUSE_AUTH_COOKIE_SECURE=false
CLEARINGHOUSE_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080
CLEARINGHOUSE_AUTH_SUCCESS_REDIRECT_URL=http://127.0.0.1:8080/
CLEARINGHOUSE_AUTH_OAUTH_ATTEMPT_LIMIT=20
CLEARINGHOUSE_AUTH_OAUTH_ATTEMPT_WINDOW_SECONDS=900

# Optional Google OIDC. Leave disabled unless every value is configured.
CLEARINGHOUSE_AUTH_GOOGLE_ENABLED=false
# CLEARINGHOUSE_AUTH_GOOGLE_CLIENT_ID=
# CLEARINGHOUSE_AUTH_GOOGLE_CLIENT_SECRET=
# CLEARINGHOUSE_AUTH_GOOGLE_CLIENT_SECRET_HOST_FILE=/run/livepeer-clearinghouse/secrets/google-client-secret
# CLEARINGHOUSE_AUTH_GOOGLE_REDIRECT_URI=https://api.example.com/v1/auth/oauth/google/callback

# Optional GitHub OAuth. Leave disabled unless every value is configured.
CLEARINGHOUSE_AUTH_GITHUB_ENABLED=false
# CLEARINGHOUSE_AUTH_GITHUB_CLIENT_ID=
# CLEARINGHOUSE_AUTH_GITHUB_CLIENT_SECRET=
# CLEARINGHOUSE_AUTH_GITHUB_CLIENT_SECRET_HOST_FILE=/run/livepeer-clearinghouse/secrets/github-client-secret
# CLEARINGHOUSE_AUTH_GITHUB_REDIRECT_URI=https://api.example.com/v1/auth/oauth/github/callback

# Dedicated signer topic binding. The payload has no trusted signer identity;
# topic ACLs and this out-of-band binding are the trust boundary.
CLEARINGHOUSE_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
CLEARINGHOUSE_KAFKA_BOOTSTRAP_SERVERS_INTERNAL=redpanda:9092
CLEARINGHOUSE_KAFKA_METERING_TOPIC=livepeer-gateway-events
CLEARINGHOUSE_KAFKA_METERING_GROUP_ID=clearinghouse-metering-v1
CLEARINGHOUSE_KAFKA_METERING_CLIENT_ID=clearinghouse-metering
CLEARINGHOUSE_METERING_MAX_PAYLOAD_BYTES=1048576
CLEARINGHOUSE_METERING_RECONCILIATION_BATCH_SIZE=100
CLEARINGHOUSE_METERING_RECONCILIATION_INTERVAL_SECONDS=30
CLEARINGHOUSE_METERING_CONFIRMATION_GRACE_SECONDS=30
CLEARINGHOUSE_METERING_HEARTBEAT_INTERVAL_SECONDS=10
CLEARINGHOUSE_METERING_HEARTBEAT_STALE_SECONDS=60

# Default Compose includes the unmodified real remote signer. `make up` runs a
# static/RPC preflight and therefore requires all fields below plus the two
# operator-owned host files. `make smoke` intentionally starts the core service
# list without the signer and performs a synthetic, nonfinancial event check.
SIGNER_MODE=evaluation
SIGNER_NETWORK=arbitrum-one-mainnet
SIGNER_CHAIN_ID=42161
SIGNER_CONTROLLER=0xD8E8328501E9645d16Cf49539efC04f734606ee4
# Provider paths/query credentials are accepted, but pinned go-livepeer may log
# this entire value until optional upstream redaction work is adopted.
ETH_RPC_URL=
SIGNER_ETH_ADDR=
SIGNER_KEYSTORE_HOST_FILE=
SIGNER_PASSWORD_HOST_FILE=
CLEARINGHOUSE_REMOTE_SIGNER_WEBHOOK_URL_INTERNAL=http://api:8000/v1/compat/go-livepeer/authorize
SIGNER_REMOTE_DISCOVERY=true
SIGNER_ORCH_ADDR=
SIGNER_MIN_GAS_WEI=
SIGNER_MIN_DEPOSIT_WEI=
SIGNER_MIN_RESERVE_WEI=
LP_KAFKAUSER=
LP_KAFKAPASSWORD_HOST_FILE=./tmp/runtime-secrets/kafka-password
CLEARINGHOUSE_KAFKA_RETENTION_MS=604800000

# Encrypted operational backups. Generate an age identity outside production
# checkouts and set the matching public recipient. The identity is restore-only.
CLEARINGHOUSE_BACKUP_AGE_RECIPIENT=
CLEARINGHOUSE_BACKUP_AGE_IDENTITY_HOST_FILE=./tmp/runtime-secrets/age-identity
CLEARINGHOUSE_BACKUP_VOLUME=livepeer-clearinghouse-encrypted-backups
OPS_BACKUP_KEY_ID=

# Required only for mutating operations CLI commands. It must identify an
# active, unscoped operator principal; status remains read-only without it.
CLEARINGHOUSE_OPERATIONS_ACTOR_ID=

# No OpenMeter, Auth0, Stripe, Turnkey, or Pymthouse service is required.
