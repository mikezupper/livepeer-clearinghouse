# Livepeer Clearinghouse — copy to .env, then replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=livepeer-clearinghouse
CLEARINGHOUSE_EDGE_PORT=8080
CLEARINGHOUSE_ENVIRONMENT=development
CLEARINGHOUSE_LOG_LEVEL=INFO
CLEARINGHOUSE_DATABASE_BUSY_TIMEOUT_MS=5000
CLEARINGHOUSE_PUBLIC_URL=http://localhost:8080
CLEARINGHOUSE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CLEARINGHOUSE_COOKIE_SECURE=false
CLEARINGHOUSE_ADMIN_EMAIL=admin@example.com

# Generate independent values with: openssl rand -base64 48 | tr -d '=+/\n' | head -c 48
CLEARINGHOUSE_AUTH_PEPPER=CHANGE_ME_AUTH_PEPPER_AT_LEAST_32_CHARACTERS
CLEARINGHOUSE_WORKLOAD_PEPPER=CHANGE_ME_WORKLOAD_PEPPER_AT_LEAST_32_CHARS
CLEARINGHOUSE_SIGNER_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET_AT_LEAST_32_CHARS

# Email OTP (a custom Resend-compatible base URL is supported).
CLEARINGHOUSE_AUTH_RESEND_API_URL=https://api.resend.com
CLEARINGHOUSE_AUTH_RESEND_API_KEY=re_CHANGE_ME
CLEARINGHOUSE_AUTH_RESEND_FROM=Livepeer Clearinghouse <auth@example.com>

# Optional OAuth; leave disabled and blank unless each provider is fully configured.
CLEARINGHOUSE_AUTH_GOOGLE_ENABLED=false
CLEARINGHOUSE_AUTH_GOOGLE_CLIENT_ID=
CLEARINGHOUSE_AUTH_GOOGLE_CLIENT_SECRET=
CLEARINGHOUSE_AUTH_GITHUB_ENABLED=false
CLEARINGHOUSE_AUTH_GITHUB_CLIENT_ID=
CLEARINGHOUSE_AUTH_GITHUB_CLIENT_SECRET=

# Discovery. go-livepeer requires remote discovery true even with a static orch list.
CLEARINGHOUSE_SIGNER_ID=signer_default0000
SIGNER_REMOTE_DISCOVERY=true
SIGNER_ORCH_ADDR=
CLEARINGHOUSE_DISCOVERY_URLS=http://remote-signer:8935/discover-orchestrators
# Optional operator-reviewed LV2V price artifact mounted into the core container.
CLEARINGHOUSE_LV2V_OFFERS_FILE=
CLEARINGHOUSE_DISCOVERY_TTL_SECONDS=3600

# Metering. Authentication is blank for the private local broker.
CLEARINGHOUSE_KAFKA_METERING_TOPIC=livepeer-gateway-events
CLEARINGHOUSE_KAFKA_METERING_GROUP_ID=clearinghouse-core-v1
LP_KAFKAUSER=
LP_KAFKAPASSWORD=
CLEARINGHOUSE_KAFKA_RETENTION_MS=604800000

# Unmodified pinned go-livepeer remote signer.
CLEARINGHOUSE_SECRET_OWNER_UID=1000
SIGNER_MODE=evaluation
SIGNER_NETWORK=arbitrum-one-mainnet
SIGNER_CHAIN_ID=42161
SIGNER_CONTROLLER=0xD8E8328501E9645d16Cf49539efC04f734606ee4
ETH_RPC_URL=https://CHANGE_ME
SIGNER_ETH_ADDR=0x0000000000000000000000000000000000000001
SIGNER_KEYSTORE_HOST_FILE=/run/livepeer-clearinghouse/secrets/signer-keystore.json
SIGNER_PASSWORD_HOST_FILE=/run/livepeer-clearinghouse/secrets/signer-password
SIGNER_MIN_GAS_WEI=1000000000000000
SIGNER_MIN_DEPOSIT_WEI=1
SIGNER_MIN_RESERVE_WEI=1
