# Merge into local .env. Never commit populated .env or secret files.
# These are configuration inputs for the signer image and preflight; Compose
# mounts the host files below to SIGNER_ETH_KEYSTORE_PATH/SIGNER_PASSWORD_FILE.
SIGNER_MODE=evaluation
SIGNER_NETWORK=arbitrum-one-mainnet
SIGNER_CHAIN_ID=42161
SIGNER_CONTROLLER=0xD8E8328501E9645d16Cf49539efC04f734606ee4
ETH_RPC_URL=
SIGNER_ETH_ADDR=
SIGNER_KEYSTORE_HOST_FILE=
SIGNER_PASSWORD_HOST_FILE=
SIGNER_ETH_KEYSTORE_PATH=/run/secrets/signer-keystore.json
SIGNER_PASSWORD_FILE=/run/secrets/signer-password
SIGNER_DATA_DIR=/data
SIGNER_PORT=8935
SIGNER_HOST_PORT=18935
SIGNER_REMOTE_DISCOVERY=true
REMOTE_SIGNER_WEBHOOK_URL=http://api:8000/v1/compat/go-livepeer/authorize
WEBHOOK_SECRET=
KAFKA_BROKERS=redpanda:9092
KAFKA_GATEWAY_TOPIC=livepeer-gateway-events
# Optional SASL credentials are passed directly through native LP_* env;
# configure both or neither. Supplying both enables TLS in this signer version.
LP_KAFKAUSER=
LP_KAFKAPASSWORD=
# Operator-selected positive readiness thresholds, all in wei. No automatic funding.
SIGNER_MIN_GAS_WEI=
SIGNER_MIN_DEPOSIT_WEI=
SIGNER_MIN_RESERVE_WEI=
